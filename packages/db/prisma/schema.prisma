generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Users & auth

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  role         Role     @default(CUSTOMER)
  credits      Int      @default(10)
  emailVerified Boolean @default(false)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile SellerProfile?
  designs       Design[]
  generations   Generation[]
  orders        Order[]
  reviews       Review[]
  sessions      Session[]
  cartItems     CartItem[]
  auditLogs     AuditLog[]
  reportsFiled  Report[]       @relation("ReportReporter")

  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model SellerProfile {
  id         String       @id @default(cuid())
  userId     String       @unique
  shopName   String
  slug       String       @unique
  bio        String?
  bannerUrl  String?
  status     SellerStatus @default(PENDING)
  commission Float        @default(0.2)
  payoutInfo Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  payouts  Payout[]
}

// ---------------------------------------------------------------- Catalog

model Garment {
  id           String   @id @default(cuid())
  slug         String   @unique
  label        String
  description  String?
  modelUrl     String
  thumbnailUrl String?
  meshName     String   @default("Shirt")
  materialName String   @default("fabric")
  basePrice    Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants   GarmentVariant[]
  printAreas PrintArea[]
  designs    Design[]
}

model GarmentVariant {
  id        String @id @default(cuid())
  garmentId String
  colorName String
  colorHex  String
  size      String
  sku       String @unique
  stock     Int    @default(100)
  priceDiff Float  @default(0)

  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, colorHex, size])
  @@index([garmentId])
}

model PrintArea {
  id        String @id @default(cuid())
  garmentId String
  name      String
  uvX       Float
  uvY       Float
  uvWidth   Float
  uvHeight  Float
  widthMm   Int
  heightMm  Int
  maxDpi    Int    @default(300)

  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, name])
}

// ---------------------------------------------------------------- Designs & AI

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Design {
  id           String     @id @default(cuid())
  ownerId      String
  garmentId    String
  name         String     @default("Untitled design")
  colorHex     String     @default("#FFFFFF")
  layers       Json
  previewUrl   String?
  printFileUrl String?
  visibility   Visibility @default(PRIVATE)
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  garment  Garment   @relation(fields: [garmentId], references: [id])
  products Product[]
  reports  Report[]

  @@index([ownerId])
  @@index([visibility])
}

enum GenerationStatus {
  QUEUED
  MODERATING
  GENERATING
  POSTPROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model Generation {
  id             String           @id @default(cuid())
  userId         String
  prompt         String
  enhancedPrompt String?
  style          String           @default("vector")
  provider       String           @default("openai")
  model          String?
  imageUrl       String?
  status         GenerationStatus @default(QUEUED)
  error          String?
  costCents      Int              @default(0)
  jobId          String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------- Marketplace

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  designId    String
  title       String
  slug        String        @unique
  description String?
  price       Float
  status      ProductStatus @default(DRAFT)
  salesCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  design     Design        @relation(fields: [designId], references: [id])
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]

  @@index([sellerId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  size      String
  colorHex  String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size, colorHex])
}

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  buyerId         String
  orderNumber     String      @unique
  subtotal        Float
  shippingCost    Float       @default(0)
  total           Float
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  shippingAddress Json
  paymentIntentId String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer User        @relation(fields: [buyerId], references: [id])
  items OrderItem[]

  @@index([buyerId, createdAt])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  sellerId     String
  size         String
  colorHex     String
  quantity     Int
  unitPrice    Float
  sellerEarned Float   @default(0)
  printFileUrl String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([sellerId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  sellerId    String
  amount      Float
  currency    String       @default("USD")
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(PENDING)
  reference   String?
  createdAt   DateTime     @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([productId, authorId])
}

// ---------------------------------------------------------------- Moderation

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  designId   String
  reporterId String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  reporter User   @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
